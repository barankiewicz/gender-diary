{
  "name": "gender-diary",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:browser": "node tests/browser-tier/run.mjs",
    "test:android": "node tests/android-tier/run.mjs",
    "test:walkthrough": "GENDER_DIARY_VERSION=9.9.9-walkthrough VITE_DEMO=1 vite build && node tests/walkthrough.test.mjs",
    "verify:build": "vite build && node tests/browser-tier/verify-build.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:licences": "node scripts/check-licences.mjs",
    "benchmark:argon2": "node scripts/benchmark-argon2.mjs",
    "benchmark:long-journal": "node tests/long-journal/run.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@inlang/paraglide-js": "^2.0.0",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^26.2.0",
    "playwright-core": "^1.62.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@evolu/sqlite-wasm": "^2.2.4",
    "@rive-app/canvas": "^2.21.0",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-shape": "^3.1.6",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "hash-wasm": "^4.12.0",
    "melt": "^0.30.0",
    "sqlocal": "^0.18.0"
  }
}
